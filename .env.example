# Court / bankruptcy
CL_TOKEN=                      # CourtListener API v4 token. Free tier: 5/min, 50/hr, 125/day
PACER_USER=                    # RECAP Fetch only. Password rotates every 180 days; MFA unsupported
PACER_PASS=

# Open data
SOCRATA_APP_TOKEN_LACITY=      # data.lacity.org
SOCRATA_APP_TOKEN_SF=          # data.sfgov.org

# Licensed feeds (optional but recommended)
ATTOM_API_KEY=                 # fills the LA County recorder gap; redistribution permitted
PROPERTYRADAR_TOKEN=           # CA trustee sales + postponement tracking. NOT resellable.
REGRID_API_KEY=                # parcels + USPS vacancy indicator

# Imagery
NEARMAP_API_KEY=
VEXCEL_API_KEY=
EAGLEVIEW_CLIENT_ID=
EAGLEVIEW_CLIENT_SECRET=
MAPILLARY_TOKEN=               # only lawful street-level CV substrate at scale

# Ops
OPS_EMAIL=                     # goes in the User-Agent header. Nowhere else.
TZ_OPERATOR=America/New_York
